# WebFlix environment variables — NAMES ONLY, never values.
# Canonical documentation: docs/infrastructure/environment-inventory.md
# Copy to .env (gitignored) and fill values from the operator secrets store.
# NEVER commit real values. Tooling variables stay in CI/operator scope only.

# ── Required app runtime ────────────────────────────────────────────────────
# Neon PostgreSQL (org webflix / project webflix / database webflix, aws-us-east-1).
# POOLED endpoint (-pooler host) — runtime default. sslmode=require.
# Direct endpoint string is operator-held for migrations/DDL (inject as
# DIRECT_DATABASE_URL at deploy time only if a migration runner needs it).
DATABASE_URL=

# 32-byte secret used to encrypt credentials at rest in Postgres (YouTube
# OAuth tokens, sensitive columns). Generate before first production deploy.
APP_ENCRYPTION_KEY=

# Cloudflare R2 object storage (bucket: webflix-media). S3-compatible SigV4.
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Optional app runtime (pair contract — absence = in-memory fallback) ─────
# Upstash Redis REST pair. NOT currently provisioned. If either is unset the
# app runs the in-memory cache fallback with typed degraded logging — see
# docs/infrastructure/degradation-behavior.md ("The env pair contract").
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Development / test control (NEVER set in production) ────────────────────
# Opt-in deterministic dev fixtures for local UX work. Production paths are
# env-driven against real DATABASE_URL; a missing DATABASE_URL is a typed
# startup error, never a fixture fallback.
WFX_DEV_FIXTURES=

# Base URL of the Experience API for split-runtime clients (web/desktop/
# mobile). Same-origin when unset.
WFX_API_BASE=

# ── Future: YouTube connector (waves 2–3 — names frozen now) ────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
YOUTUBE_API_KEY=

# ── R25: Qwen LiveTranslate realtime translation (managed cloud) ────────────
# The provider credential for the realtime translation specialist. SERVER
# ENVIRONMENT ONLY — never client code, never committed values; an absent
# key is a typed honest not-registered answer, never a hardcoded fallback.
# Consumed by @wfx/model-fabric's realtime adapter (R25-C) via the bridge
# lane (R25-D, server-side). See docs/infrastructure/environment-inventory.md.
DASHSCOPE_API_KEY=
# OPTIONAL endpoint override for deployments against the Alibaba Cloud Model
# Studio international endpoint instead of the documented QwenCloud MaaS
# realtime endpoint (the adapter's default). Name-only config.
QWEN_LIVETRANSLATE_WS_URL=

# ── Tooling only — NEVER app runtime, NEVER in this file with values ────────
# VERCEL_TOKEN, NEON_API_KEY, GITHUB_PAT, CLOUDFLARE_API_TOKEN:
# provisioning/CI/deploy credentials. They live in the operator secrets store
# and CI secret managers only — see docs/infrastructure/environment-inventory.md.
